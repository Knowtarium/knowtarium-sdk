{
  "name": "knowtarium",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Connect your AI agents to your Knowtarium workspace, end-to-end encrypted: the knowtarium CLI and MCP server, and the Knowtarium SDK.",
  "homepage": "https://knowtarium.com",
  "bugs": {
    "url": "https://github.com/Knowtarium/knowtarium-sdk/issues",
    "email": "support@knowtarium.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Knowtarium/knowtarium-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "npm-shrinkwrap.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "knowtarium": "./dist/cli/index.js"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/tsconfig.json && tsc -p src/cli/tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.js",
    "prepublishOnly": "pnpm build && pnpm test:dist",
    "build:extras": "node scripts/build-extras.js",
    "shrinkwrap": "node scripts/shrinkwrap.js",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@napi-rs/keyring": "^2.1.0",
    "diff": "^9.0.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "minisearch": "^7.2.0",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
