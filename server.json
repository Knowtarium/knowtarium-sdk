{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Knowtarium/knowtarium",
  "title": "Knowtarium",
  "description": "Search, read and write your end-to-end encrypted Knowtarium notes, and check a person's edits.",
  "websiteUrl": "https://knowtarium.com",
  "repository": {
    "url": "https://github.com/Knowtarium/knowtarium-sdk",
    "source": "github"
  },
  "version": "0.1.2",
  "icons": [
    {
      "src": "https://knowtarium.com/web-app-manifest-512x512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "knowtarium",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
